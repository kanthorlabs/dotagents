{
  // /debate writes its temp files to ~/.kanthorlabs/debate and appends run statistics
  // to ~/.kanthorlabs/state/debate.jsonl. Both paths sit outside the session
  // directory, so OpenCode guards them with the external_directory permission and
  // a non-interactive run auto-rejects them.
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "{{HOME}}/.kanthorlabs/*",
      "effect": "allow"
    }
  ],
  "compaction": {
    "auto": true,
    "buffer": 32000
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6-sol": {
          "settings": {
            "reasoningEffort": "medium"
          },
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "settings": {
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        }
      }
    }
  }
}
