{
  // /debate writes its temp files to ~/.kanthorlabs/debate and appends run statistics
  // to ~/.kanthorlabs/state/debate.jsonl. Both paths sit outside the session
  // directory, so OpenCode guards them with the external_directory permission and
  // a non-interactive run auto-rejects them.
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "{{HOME}}/.kanthorlabs/**": "allow"
    }
  },
  "compaction": {
    "auto": true
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        },
        "gpt-5.6-luna-fast": {
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        },
        "gpt-5.6-sol": {
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        },
        "gpt-5.6-sol-fast": {
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        },
        "gpt-5.6-terra-fast": {
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        }
      }
    }
  }
}
