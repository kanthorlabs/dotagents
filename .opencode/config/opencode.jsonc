{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["{{DOTAGENTS}}/hooks/secret-guard/opencode.js"],
  "compaction": {
    "auto": true,
    "buffer": 32000
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": {
            "reasoningEffort": "medium"
          },
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        },
        "gpt-6-luna": {
          "settings": {
            "reasoningEffort": "max"
          },
          "limit": {
            "context": 404000,
            "input": 276000,
            "output": 128000
          }
        }
      }
    }
  }
}
