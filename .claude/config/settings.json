{
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay {{DOTAGENTS}}/assets/audio/success.mp3"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay {{DOTAGENTS}}/assets/audio/failure.mp3"
          }
        ]
      }
    ]
  },
  "enableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "bash {{HOME}}/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "kanthorjournald@claude.kanthorlabs.com": true
  },
  "extraKnownMarketplaces": {
    "claude.kanthorlabs.com": {
      "source": {
        "source": "directory",
        "path": "{{DOTAGENTS}}/.claude/plugins"
      }
    }
  },
  "outputStyle": "concise",
  "effortLevel": "medium",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 30,
  // hide the "Co-authored-by" line in commit messages and PR
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
